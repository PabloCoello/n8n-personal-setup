# ============================================
# PostgreSQL Database Configuration
# ============================================
# Database credentials for PostgreSQL
# IMPORTANT: Change these default values for security!
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=n8n

# ============================================
# n8n Configuration
# ============================================
# Encryption key for n8n credentials storage
# IMPORTANT: Generate a secure key using: openssl rand -hex 32
# WARNING: Changing this after setup will break existing credentials!
N8N_ENCRYPTION_KEY=super-secret-key

# JWT secret for user management
# IMPORTANT: Generate a secure key using: openssl rand -hex 32
N8N_USER_MANAGEMENT_JWT_SECRET=even-more-secret

# Binary data storage mode (filesystem or default)
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# ============================================
# Ollama Configuration
# ============================================
# For Mac users running OLLAMA locally (not in Docker):
# 1. Uncomment the line below
# 2. After starting n8n, update the Ollama credential at:
#    http://localhost:5678/home/credentials
#    Set base URL to: http://host.docker.internal:11434/
# See: https://github.com/n8n-io/self-hosted-ai-starter-kit?tab=readme-ov-file#for-mac--apple-silicon-users
# OLLAMA_HOST=host.docker.internal:11434

# ============================================
# Optional: Additional n8n Configuration
# ============================================
# Uncomment and configure as needed:

# Set timezone (default: UTC)
# GENERIC_TIMEZONE=America/New_York
# TZ=America/New_York

# Webhook URL (for external access)
# N8N_WEBHOOK_URL=https://your-domain.com/

# Basic authentication (not recommended for production)
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=password

# Execution mode
# N8N_EXECUTIONS_MODE=regular

# Log level (error, warn, info, verbose, debug)
# N8N_LOG_LEVEL=info
